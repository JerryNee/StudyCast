+static void mux_control_write_status(const char *status) {
+    if (mux_control_path.empty()) return;
+
+    std::ofstream out(mux_control_path + ".status", std::ios::out | std::ios::app);
+    if (out.is_open()) {
+        out << status << std::endl;
+    }
+}
+
+static int annexb_start_code_len(const unsigned char *data, int len, int pos) {
+    if (pos + 4 <= len && data[pos] == 0x00 && data[pos + 1] == 0x00 &&
+        data[pos + 2] == 0x00 && data[pos + 3] == 0x01) {
+        return 4;
+    }
+    if (pos + 3 <= len && data[pos] == 0x00 && data[pos + 1] == 0x00 &&
+        data[pos + 2] == 0x01) {
+        return 3;
+    }
+    return 0;
+}
+
+static int annexb_find_start_code(const unsigned char *data, int len, int from) {
+    for (int i = from; i < len - 2; i++) {
+        if (annexb_start_code_len(data, len, i)) return i;
+    }
+    return -1;
+}
+
+static void mux_cache_video_header(const unsigned char *data, int len, bool is_h265) {
+    if (!data || len <= 0) return;
+
+    std::vector<unsigned char> header;
+    int start = annexb_find_start_code(data, len, 0);
+    while (start >= 0) {
+        int sc_len = annexb_start_code_len(data, len, start);
+        int nal = start + sc_len;
+        if (nal >= len) break;
+
+        int next = annexb_find_start_code(data, len, nal + 1);
+        int end = (next >= 0) ? next : len;
+
+        bool is_header_nal = false;
+        if (is_h265) {
+            int nal_type = (data[nal] >> 1) & 0x3f;
+            is_header_nal = (nal_type == 32 || nal_type == 33 || nal_type == 34);
+        } else {
+            int nal_type = data[nal] & 0x1f;
+            is_header_nal = (nal_type == 7 || nal_type == 8);
+        }
+
+        if (is_header_nal) {
+            header.insert(header.end(), data + start, data + end);
+        }
+
+        if (next < 0) break;
+        start = next;
+    }
+
+    if (!header.empty()) {
+        mux_cached_video_header = std::move(header);
+        mux_cached_video_header_h265 = is_h265;
+    }
+}
+
+static bool mux_annexb_contains_keyframe(const unsigned char *data, int len, bool is_h265) {
+    if (!data || len <= 0) return false;
+
+    int start = annexb_find_start_code(data, len, 0);
+    while (start >= 0) {
+        int sc_len = annexb_start_code_len(data, len, start);
+        int nal = start + sc_len;
+        if (nal >= len) break;
+
+        if (is_h265) {
+            int nal_type = (data[nal] >> 1) & 0x3f;
+            if (nal_type >= 16 && nal_type <= 21) return true;
+        } else {
+            int nal_type = data[nal] & 0x1f;
+            if (nal_type == 5) return true;
+        }
+
+        int next = annexb_find_start_code(data, len, nal + 1);
+        if (next < 0) break;
+        start = next;
+    }
+
+    return false;
+}
 
