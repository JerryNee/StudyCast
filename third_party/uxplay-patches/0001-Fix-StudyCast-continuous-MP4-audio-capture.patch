+static void mux_control_start_recording() {
+    if (!mux_configured) {
+        LOGW("recording control ignored: -mp4 was not configured");
+        return;
+    }
+    if (mux_to_file) {
+        LOGI("recording control: already recording");
+        return;
+    }
+
+    mux_to_file = true;
+    mux_video_header_needs_inject = true;
+    mux_video_started = false;
+    LOGI("recording control: start");
+
+    mux_renderer_choose_video_codec(mux_video_codec_known ? mux_current_video_h265 : false);
+    if (mux_audio_codec_known) {
+        mux_renderer_choose_audio_codec(mux_current_audio_ct);
+    }
+    mux_control_write_status("start");
+}
+
+static void mux_control_stop_recording() {
+    if (!mux_to_file) {
+        LOGI("recording control: already stopped");
+        return;
+    }
+
+    mux_to_file = false;
+    mux_video_header_needs_inject = false;
+    mux_video_started = false;
+    mux_renderer_stop();
+    LOGI("recording control: stop");
+    mux_control_write_status("stop");
+}
+
+#ifndef _WIN32
+static gboolean mux_control_callback(GIOChannel *source, GIOCondition condition, gpointer data) {
+    (void)data;
+    if (condition & (G_IO_ERR | G_IO_NVAL)) {
+        LOGE("recording control pipe error");
+        return TRUE;
+    }
+
+    int fd = g_io_channel_unix_get_fd(source);
+    char buffer[256];
+    ssize_t n = 0;
+    while ((n = read(fd, buffer, sizeof(buffer) - 1)) > 0) {
+        buffer[n] = '\0';
+        std::string command(buffer);
+        std::transform(command.begin(), command.end(), command.begin(), [](unsigned char c) {
+            return static_cast<char>(std::tolower(c));
+        });
+
+        if (command.find("start") != std::string::npos) {
+            mux_control_start_recording();
+        }
+        if (command.find("stop") != std::string::npos) {
+            mux_control_stop_recording();
+        }
+    }
+
+    return TRUE;
+}
+#endif
