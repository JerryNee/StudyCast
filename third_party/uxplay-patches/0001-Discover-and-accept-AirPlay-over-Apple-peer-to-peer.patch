+    if (awdl_receive && awdl_receive[0] != '\0' && strcmp(awdl_receive, "0") != 0) {
+        int receive_anyif = 1;
+        int anyif_ret = setsockopt(
+            server_fd,
+            SOL_SOCKET,
+            SO_RECV_ANYIF,
+            &receive_anyif,
+            sizeof(receive_anyif)
+        );
+        if (anyif_ret == -1) {
+            goto cleanup;
+        }
+    }
