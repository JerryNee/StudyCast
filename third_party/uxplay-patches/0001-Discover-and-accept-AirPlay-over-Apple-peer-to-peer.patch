--- a/lib/netutils.c
+++ b/lib/netutils.c
@@ -21,6 +21,15 @@
 
 #include "compat.h"
 
+#if defined(__APPLE__) && !defined(SO_RECV_ANYIF)
+/*
+ * XNU's private socket.h defines this as "unrestricted inbound processing".
+ * It is required for a conventional BSD listener to receive traffic delivered
+ * over AWDL. Keep it opt-in so normal UxPlay networking is unchanged.
+ */
+#define SO_RECV_ANYIF 0x1104
+#endif
+
