+static void
+public_key_get(uint8_t server_public_key[crypto_sign_PUBLICKEYBYTES], const char *device_id)
+{
+  uint8_t private_key[crypto_sign_SECRETKEYBYTES];
+  server_keypair(server_public_key, private_key, device_id);
+}
