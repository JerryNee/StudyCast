+            PAIR_SERVER_HOMEKIT, NULL, hkp_get_client, conn,
+            raop->hkp_device_id);
+        if (!conn->hkp_verify) {
+            logger_log(raop->logger, LOGGER_ERR,
+                       "Unable to create HomeKit pair-verify context");
+            http_response_init(response, "RTSP/1.0", 500,
+                               "Internal Server Error");
+            return;
+        }
+    }
