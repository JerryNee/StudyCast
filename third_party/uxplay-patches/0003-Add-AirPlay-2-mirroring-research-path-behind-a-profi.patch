+int
+fairplay_session_key(fairplay_t *fp, unsigned char output[16])
+{
+    if (fp->keymsglen != 164) {
+        return -1;
+    }
+
+    playfair_session_key(fp->keymsg, output);
+    return 0;
+}
+
+int
+fairplay_get_keymsg(fairplay_t *fp, unsigned char output[164])
+{
+    if (fp->keymsglen != 164) {
+        return -1;
+    }
+
+    memcpy(output, fp->keymsg, 164);
+    return 0;
+}
+
 void
 fairplay_destroy(fairplay_t *fp)
 {
