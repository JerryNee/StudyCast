+        logger_log(raop->logger, LOGGER_INFO,
+                   "HomeKit pair-verify completed");
+    }
+
+    *response_data = (char *) body;
+    *response_datalen = (int) body_len;
+    http_response_add_header(response, "Content-Type",
+                             "application/octet-stream");
+}
