+        CLOSESOCKET(conn->hkp_event_listener);
+        conn->hkp_event_listener = -1;
+        pair_cipher_free(conn->hkp_event_cipher);
+        conn->hkp_event_cipher = NULL;
+        conn->hkp_event_port = 0;
+    }
